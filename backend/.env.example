# Copy this file to .env and fill in your values
# NEVER commit .env to version control

ENVIRONMENT=development

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Database
# DATABASE_URL=sqlite:///./app.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/drkhareai

# Redis
# REDIS_URL=redis://localhost:6379/0

# Sentry
# SENTRY_DSN=

# ChromaDB path (relative to backend dir or absolute)
CHROMA_PATH=./chroma_db

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# File storage
UPLOAD_DIR=../storage/uploads

# AWS S3 Migration (Placeholders)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET_NAME=
# AWS_REGION=us-east-1

# CORS — add your frontend URL(s)
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# RAG tuning
TOP_K_CHUNKS=5
SIMILARITY_THRESHOLD=0.10
SIMILARITY_THRESHOLD_CAUTIOUS=0.25
WEB_FALLBACK_THRESHOLD=0.0
MEMORY_WINDOW=4

# Rate limiting
RATE_LIMIT=60/minute
CHAT_RATE_LIMIT=30/minute
